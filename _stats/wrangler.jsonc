{
  // Visitor statistics for chrisjpereira.com, at stats.chrisjpereira.com (see src/index.js)
  "name": "chrisjpereira-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "stats.chrisjpereira.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "chrisjpereira-stats", "database_id": "a608bcb6-8d40-4eb2-8b4d-b772369cc780" }],
  "send_email": [{ "name": "EMAIL" }],
  // once a day: drop visits older than two years (and refresh Google Search data if GSC_URL is set)
  "triggers": { "crons": ["17 3 * * *"] },
  // Secrets (Cloudflare dashboard): SALT — any long random text; it makes the daily visitor codes impossible to reverse.
  // GSC_URL (optional, not set) — a JSON feed of Google Search Console data. Without it, the Google Search section shows
  // the one-time import stored in the gsc_day and gsc_feed tables.
  "vars": { "OWNER_EMAIL": "chris@impact5r.com" },
  "observability": { "enabled": true }
}
